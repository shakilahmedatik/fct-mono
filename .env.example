# ==============================================================================
# First Cup Tech — Root Environment Variables Template
#
# Every variable the code reads is listed here. Variables marked REQUIRED are
# enforced at startup (or by docker-compose, which refuses to start without
# them) — a missing one is a configuration error, not a silent default.
# ==============================================================================

# Core Infrastructure
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/first_cup_tech"
REDIS_URL="redis://localhost:6379"
# REQUIRED in production — used by docker-compose.prod.yml to protect Redis.
REDIS_PASSWORD=""
POSTGRES_DB="first_cup_tech"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""

# Auth (Better Auth)
# REQUIRED — this signs every session cookie. A known or default value means
# anyone can forge a session. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:4000"
# REQUIRED in production — the exact origins allowed to make credentialed
# requests. Comma separated. Never use a wildcard or a suffix match.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# Leave empty for host-only cookies (the default). Set only if the API is
# served from a shared parent domain — the cookie then goes to EVERY subdomain.
COOKIE_DOMAIN=""

# Ports & URLs
API_PORT=4000
WEB_PORT=3000
CONSOLE_PORT=3001
ADMIN_PORT=3002
# The worker's health/readiness server.
WORKER_HEALTH_PORT=4001

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Billing (Paddle)
PADDLE_API_KEY=""
# REQUIRED — without it the webhook is rejected rather than processed.
PADDLE_WEBHOOK_SECRET=""

# AI & Generation
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
# A self-hosted, OpenAI-compatible endpoint.
LLM_BASE_URL=""
LLM_API_KEY=""
# Comma separated hosts that may be used as an LLM base URL. Anything not
# listed is rejected, as are private/link-local/loopback addresses.
LLM_ALLOWED_BASE_URLS=""

# Audio
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""
# The base URL used by the local-filesystem audio fallback. Leave empty to
# make the fallback fail loudly instead of publishing unreachable links.
LOCAL_AUDIO_BASE_URL=""

# Email & Notifications
RESEND_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="firstcuptech_bot"
# REQUIRED — Telegram sends this header and the webhook rejects requests
# without it.
TELEGRAM_WEBHOOK_SECRET=""

# Sources
# Optional, but the unauthenticated GitHub search API allows only ~10
# requests/minute and the configured sources issue several searches per run.
GITHUB_TOKEN=""

# S3 Object Storage (RustFS / MinIO / AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfspassword"
S3_BUCKET_NAME="first-cup-tech-audio"
# Aliases accepted by the worker for the values above.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""

# Ingestion safety
# Comma separated hosts that may be used as a custom RSS feed URL. Everything
# else is rejected, as are private/loopback/link-local addresses.
RSS_ALLOWED_HOSTS=""

# API behaviour
# Number of reverse proxies in front of the API. 0 means the API is exposed
# directly and forwarding headers are ignored entirely.
TRUSTED_PROXY_HOPS=0
# Maximum requests per client per window.
RATE_LIMIT_MAX=120
# Maximum accepted request body size in bytes.
MAX_BODY_BYTES=1048576
# Maximum time a request may take, in milliseconds.
REQUEST_TIMEOUT_MS=30000
# Set to "true" to allow the delivery adapters to report success without
# actually sending. NEVER enable this in production.
DELIVERY_MOCK="false"

# Observability
SENTRY_DSN=""
LOG_LEVEL="info"
