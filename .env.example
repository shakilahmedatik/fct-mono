# ==============================================================================
# First Cup Tech — Root Environment Variables Template
# ==============================================================================

# Core Infrastructure
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/first_cup_tech"
REDIS_URL="redis://localhost:6379"

# Auth (Better Auth)
BETTER_AUTH_SECRET="your-32-character-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:4000"

# Ports & URLs
API_PORT=4000
WEB_PORT=3000
CONSOLE_PORT=3001
ADMIN_PORT=3002

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Billing (Paddle)
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# AI & Generation
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""

# Email & Notifications
RESEND_API_KEY=""
TELEGRAM_BOT_TOKEN=""

# S3 Object Storage (RustFS / MinIO / AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfspassword"
S3_BUCKET_NAME="first-cup-tech-audio"

# Observability
SENTRY_DSN=""
LOG_LEVEL="info"
