{
  "name": "firstcup-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo --filter=@repo/db generate",
    "db:migrate": "turbo --filter=@repo/db migrate",
    "db:push": "turbo --filter=@repo/db push",
    "db:seed": "turbo --filter=@repo/db seed",
    "db:studio": "turbo --filter=@repo/db studio",
    "clean": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "typescript": "^5.8.2"
  }
}
